
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_api_key_here
# Use a PostgreSQL connection URI to store data in Supabase; SQLite remains the local default.
DATABASE_URL=sqlite:///./cascade_intelligence.db
# Example PostgreSQL URI:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
GDELT_TIMESPAN=24h
MAX_GDELT_RECORDS=75

